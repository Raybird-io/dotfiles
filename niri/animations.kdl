animations {
    window-open {
        spring damping-ratio=0.65 stiffness=1000 epsilon=0.0001
    }
    window-movement {
        spring damping-ratio=0.7 stiffness=900 epsilon=0.0001
    }
    horizontal-view-movement {
        spring damping-ratio=0.75 stiffness=1000 epsilon=0.0001
    }
    workspace-switch {
        spring damping-ratio=0.75 stiffness=900 epsilon=0.0001
    }
    window-resize {
        spring damping-ratio=0.9 stiffness=900 epsilon=0.0001
    }  
    window-close {
        spring damping-ratio=1.0 stiffness=1200 epsilon=0.0001
    }
}