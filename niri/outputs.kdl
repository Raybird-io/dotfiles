// This config is in the KDL format: https://kdl.dev
// https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

// ─── Ouputs ────────────────────────────────────────────────
    output "DP-2" { mode "1920x1080@74.973"; scale 1; transform "270"; position x=3440 y=0;  
        layout {
            struts { left 0; right 0; top 0; bottom 0; } // over writes struts to avoid blank space
            default-column-width { proportion 1.0; }  // windows are set to full screen
        } 
    }
    //output "DP-1" { mode "3440x1440@240.000"; scale 1; position x=0 y=0; variable-refresh-rate on-demand=true; }
